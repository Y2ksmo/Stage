# Copy to .env (local) or set in your host's environment settings (e.g. Vercel). Never commit real values.

DATABASE_URL="postgresql://user:password@localhost:5432/pfpa_db?schema=public"

# Email (right-of-reply notices) via Resend. Without RESEND_API_KEY, production refuses to send
# (and rolls the reply window back); in development the notice is printed to the console instead.
RESEND_API_KEY="re_..."
EMAIL_FROM="moderation@falseprophets.app" # domain must be verified in Resend.
# Until then use EMAIL_FROM="onboarding@resend.dev" (Resend test sender: only delivers to your own Resend account email).
APP_BASE_URL="https://your-domain.com"    # https required in production; used to build reply links

# Shared secret the scheduler sends as "Authorization: Bearer <secret>" to /api/cron/reply-windows.
CRON_SECRET="generate-a-long-random-string"

# Local development only (ignored in production): act as this user id for authenticated routes.
# PFPA_DEV_USER_ID=""

# Secret key for hashing login codes (REQUIRED in production; without it email login refuses to run).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-long-random-string"

# Cloudflare Turnstile (bot check on the public takedown form and the staff login request).
# The site key is PUBLIC and is inlined at BUILD time (set it before `next build`). The secret stays server-side.
# Without TURNSTILE_SECRET_KEY the check is skipped in development, and refused (fail closed) in production.
# Cloudflare's documented TEST keys (no real challenge): site "1x00000000000000000000AA" / secret "1x0000000000000000000000000000000AA" always pass;
# "2x0000000000000000000000000000000AA" always fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAX..."
TURNSTILE_SECRET_KEY="0x4AAAAAAX..."
